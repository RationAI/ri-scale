# Copy to .env (next to docker-compose.yml) to override the compose build args.
# Every value here is a BUILD-TIME arg: Next inlines NEXT_PUBLIC_* into the
# client bundle, so after changing any of them you must run
# `docker compose build`, not just `docker compose up`.
#
# Nothing secret lives here: login is a public OAuth2 client using PKCE, so
# there is no client_secret to protect.

# Path prefix to host the app under. Empty (the default) serves at the domain
# root. Set to e.g. "/ri-scale" to serve at example.com/ri-scale. Two things
# must then agree with it: the reverse proxy in front has to forward the prefix
# through rather than strip it (no StripPrefix middleware), and
# NEXT_PUBLIC_WSI_AAI_REDIRECT_URI below has to include the prefix as well.
NEXT_PUBLIC_BASE_PATH=""

# Host port to publish the container on. Behind a reverse proxy on the same
# Docker network you can drop the published port entirely.
CASE_BROWSER_PORT="3000"

NEXT_PUBLIC_WSI_ARCHIVE_BASE_URL="https://cbioportal.wsi-archive.bbmri-eric.eu/wsi-service/v3"

# Life Science AAI (https://lifescience-ri.eu) OIDC provider.
NEXT_PUBLIC_WSI_AAI_AUTH_ENDPOINT="https://login.aai.lifescience-ri.eu/oidc/authorize"
NEXT_PUBLIC_WSI_AAI_TOKEN_ENDPOINT="https://login.aai.lifescience-ri.eu/oidc/token"
NEXT_PUBLIC_WSI_AAI_CLIENT_ID="26f5be84-af80-4480-b764-f78d4ea6a519"
# Leave unset. The app derives its redirect URI from the origin it is served
# from plus NEXT_PUBLIC_BASE_PATH, so the same image works on localhost and on
# the real domain. Whatever it resolves to - e.g.
# https://example.com/ri-scale/auth/callback - still has to be registered as an
# allowed redirect URI with whoever administers the AAI client, or login fails
# on their side. Set this only to pin the value to something the origin can't
# tell you.
#NEXT_PUBLIC_WSI_AAI_REDIRECT_URI=""

# Dev-only: set this to skip the AAI login flow entirely and use this access
# token for every archive call. It ends up in the client bundle in plaintext -
# never set it on an image you publish. Leave unset for the real login flow.
# NEXT_PUBLIC_WSI_DEV_TOKEN=""

{
  "core": {
    "gateway": "../",
    "active_client": "localhost",
    "client": {
      "localhost": {
        "domain": "http://127.0.0.1:9000/",
        "path": "",
        "slide_protocols": {
          "wsi_service": {
            "url": "`http://127.0.0.1:8080/v3/slides/info?slide_id=${encodeURIComponent(data)}`",
            "tileSourceClass": "RationaiStandaloneV3TileSource"
          },
          "plain_image": {
            "url": "({type:'image',url:data,buildPyramid:false})"
          }
        },
        "default_background_protocol": "wsi_service",
        "default_visualization_protocol": "wsi_service",
        "headers": {},
        "js_cookie_expire": 365,
        "js_cookie_path": "/",
        "js_cookie_same_site": "",
        "js_cookie_secure": "",
        "secureMode": false,
        "pluginSelectionMode": "available"
      }
    },
    "setup": {
      "locale": "en",
      "scaleBar": true,
      "statusBar": true,
      "activeBackgroundIndex": 0,
      "activeVisualizationIndex": 0,
      "tileCache": true,
      "permaLoadPlugins": true,
      "bypassCookies": false,
      "theme": "auto",
      "maxImageCacheCount": 1200,
      "webGlPreferredVersion": "2.0",
      "headers": {},
      "preferredFormat": "zip",
      "fetchAsync": false
    },
    "server": {
      "staticRoots": [
        "overlay-data"
      ]
    }
  },
  "modules": {
    "rationai-wsi-tile-source": {
      "enabled": true,
      "permaLoad": true
    },
    "empaia-wsi-tile-source": {
      "permaLoad": true
    }
  },
  "plugins": {
    "gui_annotations": {
      "permaLoad": true,
      "ioFormat": "geo-json",
      "modalHistoryWindow": false,
      "staticPresets": [
        {
          "presetID": "lymph_node",
          "factoryID": "polygon",
          "color": "#1fb58f",
          "meta": {
            "category": {
              "name": "Name",
              "value": "Lymph node"
            }
          }
        },
        {
          "presetID": "tissue_Nerve",
          "factoryID": "polygon",

# Copy to .env.local. This app has no backend of its own - everything here
# is NEXT_PUBLIC_ and ends up in the client bundle. Nothing secret lives
# here: login is a public OAuth2 client using PKCE, so there is no
# client_secret to protect.

NEXT_PUBLIC_WSI_ARCHIVE_BASE_URL="https://cbioportal.wsi-archive.bbmri-eric.eu/wsi-service/v3"

# Life Science AAI (https://lifescience-ri.eu) OIDC provider.
NEXT_PUBLIC_WSI_AAI_AUTH_ENDPOINT="https://login.aai.lifescience-ri.eu/oidc/authorize"
NEXT_PUBLIC_WSI_AAI_TOKEN_ENDPOINT="https://login.aai.lifescience-ri.eu/oidc/token"
NEXT_PUBLIC_WSI_AAI_CLIENT_ID="26f5be84-af80-4480-b764-f78d4ea6a519"
# Must be registered as an allowed redirect URI for this client with
# whoever administers it, or login will fail with an AAI-side error.
NEXT_PUBLIC_WSI_AAI_REDIRECT_URI="http://localhost:3000/auth/callback"

# Dev-only: set this to skip the AAI login flow entirely and use this access
# token for every archive call (e.g. one copied from `wsi_auth_tokens` in
# localStorage, or issued some other way). No refresh - once it expires
# you'll need to paste in a new one. Leave unset for the real login flow.
# NEXT_PUBLIC_WSI_DEV_TOKEN=""
